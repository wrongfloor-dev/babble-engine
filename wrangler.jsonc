// Cloudflare Workers, static assets only. Only site/ is published: dossier/, metingen/, tests/ stay out.
{
  "name": "babble-engine",
  "compatibility_date": "2026-10-01",
  // Custom domains: on deploy Cloudflare creates the DNS records itself (wrongfloor.studio is a zone in this account).
  // babbleengine.* was the first address (2026-10-25); a Cloudflare Redirect Rule sends it to babble.* with a 301.
  "routes": [
    { "pattern": "babble.wrongfloor.studio", "custom_domain": true },
    { "pattern": "babbleengine.wrongfloor.studio", "custom_domain": true }
  ],
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
